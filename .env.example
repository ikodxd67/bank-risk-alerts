# Скопировать в .env. Пароли только для локального стенда.
ORACLE_PASSWORD=oracle_sys_pw
SRC_PASSWORD=src_pw
DWH_PASSWORD=dwh_pw
# Бот для сообщений о падениях DAG: токен от @BotFather и id чата
TG_BOT_TOKEN=
TG_CHAT_ID=
# Superset: ключ шифрования метаданных (любая длинная случайная строка) и пароль пользователя admin
SUPERSET_SECRET_KEY=change_me_to_a_long_random_string
SUPERSET_ADMIN_PASSWORD=change_me
